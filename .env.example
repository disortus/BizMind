# =========================================================================
# BizMind Environment Configuration Template
# Copy to .env and adjust values for your deployment
# =========================================================================

# Port on the host machine to bind the frontend reverse proxy (default: 80 or 8080)
FRONTEND_PORT=80

# Environment mode: development | staging | production
ENVIRONMENT=production

# SQLite database file path inside the container (mounted via docker volume)
DATABASE_PATH=/app/data/bizmind.db

# Optional: custom secret key if session management is enabled in future
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Optional: server hostname or domain name (e.g. bizmind.kz or 192.168.1.100)
SERVER_NAME=localhost
